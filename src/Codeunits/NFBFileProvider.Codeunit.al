codeunit 50117 "NFB File Provider" implements "NFB IFiscal Provider"
{
    // File Only mode: another system transmits the NF-e. The user downloads the XML (or the PlugNotas JSON),
    // and imports the authorized XML (nfeProc) or the event XML (procEventoNFe) back with Import Authorized XML.

    var
        ExternalMsg: Label 'In File Only mode the NF-e is transmitted by another system. Download the XML, transmit it and then use Import Authorized XML to bring back the authorized XML.';
        ExternalEventErr: Label 'In File Only mode events are registered by another system. Register the event there and use Import Authorized XML with the event XML (procEventoNFe).';
        NoConnectionTxt: Label 'File Only mode does not connect to any authorizer.';

    procedure Send(var NFBDocumentHeader: Record "NFB Document Header")
    var
        NFBFileMgt: Codeunit "NFB File Mgt";
    begin
        // The XML is already generated by NFB Provider Mgt; hand it to the user.
        NFBFileMgt.DownloadXml(NFBDocumentHeader);
        Message(ExternalMsg);
    end;

    procedure QueryStatus(var NFBDocumentHeader: Record "NFB Document Header")
    begin
        Error(ExternalMsg);
    end;

    procedure Cancel(var NFBDocumentHeader: Record "NFB Document Header"; var NFBDocumentEvent: Record "NFB Document Event")
    begin
        Error(ExternalEventErr);
    end;

    procedure CorrectionLetter(var NFBDocumentHeader: Record "NFB Document Header"; var NFBDocumentEvent: Record "NFB Document Event")
    begin
        Error(ExternalEventErr);
    end;

    procedure QueryEventStatus(var NFBDocumentHeader: Record "NFB Document Header"; var NFBDocumentEvent: Record "NFB Document Event")
    begin
        Error(ExternalEventErr);
    end;

    procedure TestConnection(): Text
    begin
        exit(NoConnectionTxt);
    end;
}
